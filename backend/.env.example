# ============================================
# BACKEND ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env and fill in real values
# ============================================

# Server Port (Default: 5000, Render uses PORT automatically)
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# PostgreSQL Connection String (from Neon.tech or database provider)
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key for Admin Authentication (Min 32 random characters)
JWT_SECRET="expo26_super_secret_jwt_key_masters_kerala_2026"

# Frontend Application URL (used for CORS and email links)
# Development: http://localhost:3000
# Production: https://expokerala.netlify.app
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000,https://expokerala.netlify.app"

# Default Admin Account (created automatically on server boot)
ADMIN_EMAIL="mastersassociationmedia@gmail.com"
ADMIN_PASSWORD="change_this_admin_password"

# SMTP Mailer Settings (Optional - Nodemailer falls back to Ethereal if omitted)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="info@solarmasters.org"
SMTP_PASS="your_smtp_app_password_here"
