# ============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this to .env and fill in real values
# ============================================

# PostgreSQL from Neon (get from neon.tech dashboard)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/expokerala?sslmode=require"

# JWT Secret — use a long random string
JWT_SECRET="change_this_to_a_long_random_secret_min_32_chars"

# CORS — set to your Netlify frontend URL
CORS_ORIGIN="https://your-app.netlify.app"

# Node environment
NODE_ENV="production"

# Port — Render uses 10000 automatically
PORT=10000

# Default Admin Account (created on first boot)
ADMIN_EMAIL="mastersassociationmedia@gmail.com"
ADMIN_PASSWORD="change_this_strong_password"
