// Enterprise Prisma Schema for Masters EXPO26 Backend
// Optimized for High-Scale Registrations with B-Tree Indexes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  EVENT_MANAGER
  GATE_OFFICER
}

enum VisitorCategory {
  VISITOR
  DELEGATE
  VIP
  EXHIBITOR
  PRESS
  SPEAKER
}

enum VisitorStatus {
  REGISTERED
  CHECKED_IN
  ON_BREAK
  CHECKED_OUT
  CANCELLED
}

enum ExhibitorStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // Bcrypt Hashed
  role      Role     @default(GATE_OFFICER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  GateLogs  GateLog[]

  @@index([email])
}

model Visitor {
  id           String          @id @default(cuid())
  badgeCode    String          @unique // Format: EXPO26-XXXXX
  fullName     String
  email        String
  phone        String
  company      String?
  designation  String?
  city         String?
  district     String?
  state        String?         @default("Kerala")
  pincode      String?
  address      String?
  post         String?
  landmark     String?
  country      String?         @default("India")
  countryCode  String?         @default("91")
  category     VisitorCategory @default(VISITOR)
  status       VisitorStatus   @default(REGISTERED)
  subEvents    String[]        @default([])
  notes        String?
  checkedInAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  GateLogs     GateLog[]
  ExhibitorLeads ExhibitorLead[]

  // Indexes for 75,000+ Scale & Under-20ms Queries
  @@index([badgeCode])
  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Exhibitor {
  id              String          @id @default(cuid())
  companyName     String
  contactPerson   String
  email           String          @unique
  phone           String
  website         String?
  productCategory String?
  stallNumber     String?
  stallSize       String?
  status          ExhibitorStatus @default(PENDING)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employees       CompanyEmployee[]
  leads           ExhibitorLead[]

  @@index([companyName])
  @@index([email])
  @@index([status])
}

model ExhibitorLead {
  id          String    @id @default(cuid())
  exhibitorId String
  exhibitor   Exhibitor @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)
  visitorId   String
  visitor     Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  rating      String    @default("WARM") // HOT, WARM, COLD
  notes       String?
  scannedBy   String?
  scannedAt   DateTime  @default(now())

  @@unique([exhibitorId, visitorId])
  @@index([exhibitorId])
  @@index([visitorId])
  @@index([rating])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  venue       String?
  startDate   DateTime?
  endDate     DateTime?
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyEmployee {
  id          String     @id @default(cuid())
  fullName    String
  companyName String
  email       String     @unique
  phone       String
  designation String?
  badgeCode   String?
  status      String     @default("ACTIVE")
  exhibitorId String?
  exhibitor   Exhibitor? @relation(fields: [exhibitorId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([companyName])
  @@index([exhibitorId])
}


model MasterItem {
  id        String   @id @default(cuid())
  type      String   // e.g., CATEGORY, HALL, GATE, DESIGNATION
  name      String
  code      String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  @@index([type])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model GatePass {
  id         String   @id @default(cuid())
  passNumber String   @unique
  type       String   // GATE_IN or GATE_OUT
  visitorId  String?
  status     String   @default("UNUSED") // USED or UNUSED
  scannedAt  DateTime?
  createdAt  DateTime @default(now())
}

model SubEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  speaker     String?
  location    String?
  date        String?
  timeSlot    String?
  capacity    Int      @default(200)
  createdAt   DateTime @default(now())

  @@index([title])
}

model Gate {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  hall      String?  @default("Main Hall")
  status    String   @default("ACTIVE") // ACTIVE or INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GateLog {
  id          String   @id @default(cuid())
  visitorId   String
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  scannedById String?
  scannedBy   User?    @relation(fields: [scannedById], references: [id])
  scannedAt   DateTime @default(now())
  gateName    String   @default("Main Entrance")
  scanType    String   @default("ENTRY") // ENTRY or EXIT
  status      String   @default("SUCCESS") // SUCCESS, DENIED, DUPLICATE_ENTRY
  notes       String?

  @@index([visitorId])
  @@index([scannedAt])
  @@index([scanType])
  @@index([status])
}

model EmailCampaign {
  id              String    @id @default(cuid())
  title           String
  subject         String
  targetAudience  String    @default("VISITORS") // VISITORS, EXHIBITORS, ALL
  templateType    String    @default("CUSTOM") // WELCOME, REMINDER, ANNOUNCEMENT, CUSTOM
  content         String
  status          String    @default("DRAFT") // DRAFT, SCHEDULED, IN_PROGRESS, COMPLETED, FAILED
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int       @default(0)
  sentCount       Int       @default(0)
  failedCount     Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([targetAudience])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  action     String   // e.g., EXPORT_LEADS_CSV, EXPORT_VISITORS_CSV, USER_LOGIN, DELETE_VISITOR
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model GateDevice {
  id          String   @id @default(cuid())
  deviceName  String
  deviceToken String   @unique
  gateName    String   @default("Main Entrance")
  status      String   @default("ACTIVE") // ACTIVE, REVOKED
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([deviceToken])
  @@index([status])
}




